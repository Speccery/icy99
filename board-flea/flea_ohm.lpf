BLOCK RESETPATHS;
BLOCK ASYNCPATHS;
## FleaFPGA Ohm A5 Pin Constraints File for icy99 project
## Generated from FleaFPGA_Ohm_A5.lpf with syntax adapted from ulx3s.lpf
## Author: Erik Piehl

## 25MHz MASTER CLOCK
LOCATE COMP "clk_25mhz" SITE "H2";
IOBUF PORT "clk_25mhz" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25.000000 MHz;

## USER LED
LOCATE COMP "n_led1" SITE "P2";
IOBUF PORT "n_led1" PULLMODE=NONE IO_TYPE=LVCMOS33;

## USB SLAVE UART
LOCATE COMP "slave_tx_o" SITE "P1";
LOCATE COMP "slave_rx_i" SITE "P3";
IOBUF PORT "slave_tx_o" IO_TYPE=LVCMOS33;
IOBUF PORT "slave_rx_i" IO_TYPE=LVCMOS33 PULLMODE=NONE;

## PS/2 PORTS
LOCATE COMP "PS2_enable" SITE "N1";
LOCATE COMP "ps2_clk2" SITE "K2";
LOCATE COMP "ps2_data2" SITE "J1";
IOBUF PORT "PS2_enable" IO_TYPE=LVCMOS33 PULLMODE=NONE;
IOBUF PORT "ps2_clk2" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF PORT "ps2_data2" PULLMODE=UP IO_TYPE=LVCMOS33;

## USB HOST PORTS (used for PS/2 in legacy mode)
LOCATE COMP "usb_fpga_dp" SITE "P20";  # Mapped to appropriate USB pins
LOCATE COMP "usb_fpga_dn" SITE "R20";  # Mapped to appropriate USB pins
IOBUF PORT "usb_fpga_dp" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF PORT "usb_fpga_dn" PULLMODE=UP IO_TYPE=LVCMOS33;

## RASPI COMPATIBLE GPIO HEADER
LOCATE COMP "GPIO_2" SITE "D17";
LOCATE COMP "GPIO_3" SITE "C18";
IOBUF PORT "GPIO_2" IO_TYPE=LVCMOS33 PULLMODE=NONE;
IOBUF PORT "GPIO_3" IO_TYPE=LVCMOS33 PULLMODE=NONE;


## SDRAM - Full SDRAM interface for USE_SDRAM builds
LOCATE COMP "sdram_clk" SITE "C17";
LOCATE COMP "sdram_cke" SITE "C15";
LOCATE COMP "sdram_csn" SITE "C11";
