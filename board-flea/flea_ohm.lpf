IOBUF PORT "sdram_casn" IO_TYPE=LVCMOS33;
IOBUF PORT "sdram_wen" IO_TYPE=LVCMOS33;
IOBUF PORT "sdram_dqm[1]" IO_TYPE=LVCMOS33;
